# SAM Configuration Template
# Copy this to samconfig.toml and update with your values

version = 0.1

[default]
[default.global.parameters]
stack_name = "genai-document-generator"

[default.build.parameters]
cached = true
parallel = true

[default.deploy.parameters]
capabilities = "CAPABILITY_IAM"
confirm_changeset = true
resolve_s3 = true
region = "us-east-1"
parameter_overrides = [
  "ExistingUserPoolId=GenAI-DocGen-UserPool",
  "AllowedOrigin=*"
]

