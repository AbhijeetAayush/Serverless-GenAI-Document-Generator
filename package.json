{
  "name": "serverless-genai-document-generator",
  "version": "1.0.0",
  "description": "Serverless GenAI Document Generator - Maintenance Technician Document Processing System",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "sam build",
    "deploy": "sam deploy",
    "validate": "sam validate",
